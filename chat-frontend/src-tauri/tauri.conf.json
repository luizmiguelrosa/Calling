{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chat-frontend",
  "version": "0.1.0",
  "identifier": "com.masso.chat-frontend",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/chat-frontend/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Calling",
        "width": 480,
        "height": 720,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
