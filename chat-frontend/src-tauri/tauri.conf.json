{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talk",
  "version": "1.3.0",
  "identifier": "com.luizmiguelrosa.talk",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/talk/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Talk",
        "width": 480,
        "height": 720,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
